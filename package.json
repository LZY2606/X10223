{
  "name": "gelbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "胶道标尺：电泳条带、泳道弯曲与分子量校准工作台",
  "scripts": {
    "build:cases": "tsx scripts/build-cases.ts",
    "predev": "npm run build:cases",
    "dev": "vite --host 127.0.0.1 --port 5342 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "pretest": "npm run build:cases",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
