{
  "name": "gel-lane-calibration-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "胶道标尺：电泳条带、泳道弯曲与分子量校准工作台",
  "scripts": {
    "gen:case": "node tools/generate-case.mjs",
    "postinstall": "node tools/generate-case.mjs",
